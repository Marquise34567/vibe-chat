{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    { "source": "/omegle-alternatives", "destination": "/best-omegle-alternatives", "permanent": true },
    { "source": "/monkey-app-alternative", "destination": "/monkey-app-alternatives", "permanent": true },
    { "source": "/chatroulette-alternative", "destination": "/best-chatroulette-alternatives", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-pages.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/((?!llms.txt|facefrenzy2026.txt).*)", "destination": "/api/ssr" }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
